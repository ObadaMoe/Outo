<?xml version="1.0" encoding="utf-8"?>
<!-- Otility reads only these map apps' screens, and only while "Read the map's screen" is on. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:packageNames="com.waze,com.waze.preview,com.google.android.apps.maps,app.revanced.android.apps.maps"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/map_reader_description" />
